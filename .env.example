# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public browser analytics
NEXT_PUBLIC_POSTHUG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHUG_HOST=https://us.i.posthog.com

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
GEOAPIFY_KEY=
CARTO_KEY=

# Optional Vercel CLI token for non-interactive usage.
VERCEL_TOKEN=

# Optional canonical public site URL.
# - Leave UNSET in local development; it defaults to http://localhost:3000
# - For production/staging with a custom domain, set a full URL (no trailing slash), e.g.:
#   NEXT_PUBLIC_SITE_URL=https://turistar.me
NEXT_PUBLIC_SITE_URL=
