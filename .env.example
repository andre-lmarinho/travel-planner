# ********** INDEX **********
#
# - SUPABASE
#   - Client (browser)
#   - Server (secrets)
# - ANALYTICS
# - MAP SERVICES
# - SITE CONFIGURATION
# - DEPLOYMENT

# - SUPABASE ************************************************************************************************

#   - Client (browser) ******************************************************************************
# These are safe to expose in the browser. Used by the Supabase client SDK.
# Defaults below point to the local Supabase instance started with `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

#   - Server (secrets) ******************************************************************************
# Never expose these to the browser. Used for privileged operations (row-level security bypass, admin tasks).
# Get the local value with `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=

# ***********************************************************************************************************

# - ANALYTICS ***********************************************************************************************
# PostHog — leave blank to disable. When set, events are tracked in the browser.
NEXT_PUBLIC_POSTHUG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ***********************************************************************************************************

# - MAP SERVICES *******************************************************************************************
# Geoapify — geocoding, places, routing. Required for search features.
# Get a key at https://www.geoapify.com/
GEOAPIFY_KEY=

# CARTO — vector tile rendering. Required for map display.
# Get a key at https://carto.com/
CARTO_KEY=

# ***********************************************************************************************************

# - SITE CONFIGURATION ***********************************************************************************
# Canonical public URL. Used for SEO, Open Graph, and absolute links.
# Leave UNSET in local development (defaults to http://localhost:3000).
# For production, set a full URL without trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://turistar.me
NEXT_PUBLIC_SITE_URL=

# ***********************************************************************************************************

# - DEPLOYMENT *********************************************************************************************
# Vercel CLI token — only needed for non-interactive Vercel deployments (CI/CD).
# Generate at https://vercel.com/account/tokens
VERCEL_TOKEN=

# ***********************************************************************************************************
